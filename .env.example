# Sanitized template — copy to .env (or export these directly in your shell)
# and fill in real values locally. Never commit a filled-in .env; it is
# gitignored. See docs/SETUP.md and docs/SECURITY.md for details.
#
# This project reads secrets from the environment ONLY — nothing here should
# ever be hardcoded in soar/, ai/, or redteam-mcp/ source.

# --- TheHive -----------------------------------------------------------
THEHIVE_URL=http://<thehive-host>:9000
THEHIVE_API_KEY=${THEHIVE_API_KEY}

# --- Cortex responders (used by soar/agent_orchestrator.py, soar/e2e_soc_orchestrator.py) --
CORTEX_ID=<cortex-id>
RESPONDER_NAME=<pfsense-block-responder-name>
MAILER_RESPONDER_NAME=<mailer-responder-name>

# --- Elasticsearch (used by soar/agent_tools.py) ------------------------
ES_URL=http://<es-host>:9200
ES_USER=elastic
ES_PASSWORD=${ELASTIC_PASSWORD}

# --- pfSense SSH verification (soar/pfsense_verify.py) -------------------
PFSENSE_HOST=<pfsense-host-or-tailscale-ip>
PFSENSE_SSH_USER=admin
PFSENSE_SSH_PASSWORD=${PFSENSE_PASSWORD}
PFSENSE_SSH_TIMEOUT=15
PFSENSE_BLOCK_TABLE=EasyRuleBlockHostsWAN

# --- Ollama / AI triage (soar/agent_orchestrator.py, ai/benchmark.py) ----
OLLAMA_BASE_URL=http://<ollama-host>:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_TIMEOUT=180

# --- SOAR orchestrator runtime knobs -------------------------------------
SOAR_DRY_RUN=1
SOAR_AGENT_DRY_RUN=1
SOAR_AGENT_MODE=
SOAR_AGENT_MAX_ITERS=
SOAR_ONCE=
SOAR_ALERT_ID=
SOAR_MAX_ALERTS=
SOAR_MAX_BLOCKS_HOUR=5
SOAR_MIN_CONFIDENCE=0.75
SOAR_L1_CLOSE_MIN_CONF=
SOAR_L1_CONTAIN_MIN_CONF=
SOAR_L2_LOGIN=soc-l2
SOAR_L2_EMAILS=
SOAR_AUDIT_LOG=soar/soar_audit.jsonl
SOAR_KILL_SWITCH=soar/KILL_SWITCH

# --- redteam-mcp (server.py -> Kali attacker box, lab-scope only) --------
KALI_HOST=<kali-tailscale-ip>
KALI_USER=kali
KALI_PASS=${KALI_PASSWORD}
REDTEAM_TIMEOUT=120
REDTEAM_MAX_OUTPUT=20000

# NOTE: L2 notification in soar/agent_orchestrator.py goes through TheHive's
# Cortex "Mailer_1_0" responder (MAILER_RESPONDER_NAME above), not a direct
# SMTP/Gmail integration — there is no separate mail-credential env var to
# set here. (Gmail app passwords are still checked for in the secret scan —
# see docs/SECURITY.md — in case that changes.)
